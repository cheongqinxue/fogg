// FOGG relational schema (domain model → Postgres-oriented DDL sketch)
// Visualize: https://dbdiagram.io — Import this file (docs/domain/schema.dbml)
// Human concepts: docs/domain/domain-model.md

Project fogg {
  database_type: 'PostgreSQL'
  Note: '''
    Requires PostGIS for places.geom / bounds_geom, events.affected_geom, routes.path_geom (see docs/domain/geospatial.md).
    Places & events are user-scoped catalog (not owned by trips).
    Trips reference places via activities/routes. Activities rows only when place + starts_at known.
    Itinerary = materialized home→…→home path (itinerary_versions + steps index).
    User secrets: device-first in product; server slots optional later.
    Dialogue: conversation_messages + message_entity_links; preferences + evidence + supersession (no fulfillment table).
  '''
}

// --- Enums ---

Enum activity_route_status {
  wishlisted
  reserved
  in_progress
  completed
}

Enum event_status {
  suspected
  known
  in_progress
  completed
}

Enum trip_lifecycle_status {
  draft
  planned
  booked
  in_progress
  completed
}

Enum reservation_link_kind {
  activity
  route
}

Enum domain_entity_kind {
  user
  place
  event
  trip
  activity
  route
  reservation
  itinerary_version
}

Enum message_role {
  user
  assistant
  system
  tool
}

Enum preference_evidence_source {
  user_explicit
  agent_extracted
  inferred
}

Enum itinerary_version_status {
  valid
  broken
  superseded
}

Enum itinerary_step_kind {
  home
  activity
  route
}

Enum reminder_kind {
  once
  monitor
}

Enum immigration_status_kind {
  citizenship
  permanent_resident
  visa
}

// --- User & profile ---

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_bio_details {
  user_id uuid [pk, ref: > users.id]
  gender text
  home_formatted_address text
  home_google_place_id text
  home_viewport jsonb
  home_geom text [note: 'PostGIS geography(POINT,4326); GiST optional — see geospatial.md']
  updated_at timestamptz [not null, default: `now()`]
}

Table immigration_statuses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2 — country the status applies to']
  kind immigration_status_kind [not null]
  valid_from date
  valid_until date [note: 'visas, some PR; open-ended citizenship may leave null']
  label text [note: 'optional visa class or free text, e.g. tourist, work']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
    (user_id, country_code, kind)
  }
}

// --- Known world (not trip-owned) ---

Table places {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  display_name text
  google_place_id text
  google_primary_type text
  google_types text[]
  geom text [note: 'PostGIS geography(POINT,4326); set on ingest from Geocode/Places; GiST index in migration']
  bounds_geom text [note: 'PostGIS geography(POLYGON,4326) — from google_viewport or region; GiST']
  google_viewport jsonb
  address_components jsonb
  place_details jsonb [note: 'Google GET + cached fields']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
    (google_place_id)
  }

  Note: 'CREATE INDEX … USING GIST (geom); CREATE INDEX … USING GIST (bounds_geom);'
}

Table events {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  place_id uuid [not null, ref: > places.id]
  title text
  summary text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status event_status [not null, default: 'suspected']
  organizer_name text
  organizer_contact jsonb [note: 'phone, email, url']
  tickets_required boolean [default: false]
  opening_hours jsonb
  affected_geom text [note: 'PostGIS geography(POLYGON,4326) — strike/zone; NULL → use place.bounds_geom']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, starts_at, ends_at)
    (place_id)
  }

  Note: 'CREATE INDEX … USING GIST (affected_geom);'
}

// --- Trip planning ---

Table trips {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  title text
  lifecycle_status trip_lifecycle_status [not null, default: 'draft']
  window_start date
  window_end date
  head_itinerary_version_id uuid [note: 'selected valid snapshot; FK below']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
  }
}

Table activities {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id]
  place_id uuid [not null, ref: > places.id]
  parent_activity_id uuid [ref: > activities.id, note: 'optional UI grouping only — not geographic hierarchy']
  label text
  starts_at timestamptz [not null, note: 'required with place_id before row exists — no partial activities']
  ends_at timestamptz [note: 'optional; open-ended visit allowed']
  status activity_route_status [not null, default: 'wishlisted']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id)
    (place_id)
  }
}

Table routes {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id]
  from_place_id uuid [not null, ref: > places.id]
  to_place_id uuid [not null, ref: > places.id]
  is_daytrip boolean [not null, default: false]
  transport_mode text
  operator_hint text
  departs_at timestamptz
  arrives_at timestamptz
  status activity_route_status [not null, default: 'wishlisted']
  google_route_ref jsonb [note: 'trimmed computeRoutes payload; encoded polyline per leg']
  path_geom text [note: 'NULL: air/sea/daytrip/no computeRoutes; else PostGIS geography(LINESTRING,4326) from decoded polyline — GiST in migration']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id)
  }

  Note: 'CREATE INDEX routes_path_geom_gix ON routes USING GIST (path_geom) WHERE path_geom IS NOT NULL;'
}

// --- Itinerary snapshots (materialized home→…→home paths; internal index) ---

Table itinerary_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id]
  version_number int [not null, note: 'internal monotonic per trip — not primary UX']
  status itinerary_version_status [not null, default: 'valid']
  label text [note: 'optional user-facing plan name, e.g. Return via Narita']
  broken_reason text [note: 'set when route/place/activity invalidates this path']
  committed_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id, version_number) [unique]
    (trip_id, status)
  }
}

Ref: trips.head_itinerary_version_id - itinerary_versions.id

Table itinerary_version_steps {
  id uuid [pk, default: `gen_random_uuid()`]
  itinerary_version_id uuid [not null, ref: > itinerary_versions.id]
  sequence int [not null, note: '0..N ordered path home → … → home']
  step_kind itinerary_step_kind [not null]
  activity_id uuid [ref: > activities.id]
  route_id uuid [ref: > routes.id]

  indexes {
    (itinerary_version_id, sequence) [unique]
    (itinerary_version_id, activity_id)
    (itinerary_version_id, route_id)
    (activity_id)
    (route_id)
  }

  Note: '''
    CHECK per row:
    step_kind=home → activity_id AND route_id NULL
    step_kind=activity → activity_id NOT NULL, route_id NULL
    step_kind=route → route_id NOT NULL, activity_id NULL
  '''
}

// Preferences (after trips — optional trip scope)
Table preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  trip_id uuid [ref: > trips.id, note: 'NULL = user-wide default']
  key text [not null, note: 'e.g. walkable, food.dish_to_try']
  value jsonb [not null, default: '{}']
  note text [note: 'May include <place id=N>label</place> tags; geo via tagged_place_refs — not inline coords']
  superseded_preference_ids uuid[] [not null, default: '{}', note: 'ids this row replaces; walk for history']
  superseded_at timestamptz [note: 'set when replaced by a newer row; NULL = active head']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, trip_id, key) [unique, note: 'partial in migration: WHERE superseded_at IS NULL']
    (user_id, superseded_at)
  }

  Note: 'Active prefs only: superseded_at IS NULL. Embedding index (pgvector) excludes superseded rows.'
}

// --- Reminders & monitors (one table: kind=once | monitor) ---

Table reminders {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  trip_id uuid [ref: > trips.id, note: 'optional scope']
  thread_id uuid [ref: > conversation_threads.id, note: 'conversation to surface in; optional']
  kind reminder_kind [not null, default: 'once']
  alert_at timestamptz [not null, note: 'next time to inject into dialogue; monitor advances after each fire']
  note text [not null, note: 'free-text brief; may cite entity ids inline — no link table']
  interval_seconds int [note: 'monitor only: add to alert_at after each fire']
  monitor_until timestamptz [note: 'monitor only: stop recurring after this; NULL = until deleted']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, alert_at)
    (trip_id, alert_at)
    (kind, alert_at)
  }
}

// --- Reservations & documents ---

Table reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  operator_name text
  point_of_contact text
  contact_details jsonb
  deposit_paid numeric(12,2)
  balance_due numeric(12,2)
  currency char(3)
  payment_notes jsonb
  stale boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id)
  }
}

Table reservation_links {
  reservation_id uuid [not null, ref: > reservations.id]
  link_kind reservation_link_kind [not null]
  activity_id uuid [ref: > activities.id]
  route_id uuid [ref: > routes.id]

  indexes {
    (reservation_id, link_kind, activity_id, route_id) [unique]
  }

  Note: 'CHECK: exactly one of activity_id or route_id set per link_kind'
}

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [ref: > trips.id]
  reservation_id uuid [ref: > reservations.id]
  storage_key text [not null, note: 'blob path or external id — not inline bytes']
  mime_type text
  title text
  created_at timestamptz [not null, default: `now()`]
}

// --- Conversation (LangGraph-compatible message log) ---

Table conversation_threads {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  trip_id uuid [ref: > trips.id, note: 'NULL = global / pre-trip chat']
  parent_thread_id uuid [ref: > conversation_threads.id]
  fork_at_message_id uuid [note: 'FK optional — message where fork branched']
  is_canonical boolean [not null, default: false, note: 'one canonical thread per trip when trip-scoped']
  title text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
    (trip_id)
  }
}

Table conversation_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  thread_id uuid [not null, ref: > conversation_threads.id]
  seq int [not null, note: 'monotonic order within thread for replay']
  role message_role [not null]
  content text [not null, note: 'Text + <place id=N>label</place> tags; geo via tagged_place_refs; jsonb later for multimodal']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (thread_id, seq) [unique]
    (thread_id, created_at)
  }
}

Ref: conversation_threads.fork_at_message_id - conversation_messages.id

Table message_entity_links {
  message_id uuid [not null, ref: > conversation_messages.id]
  entity_kind domain_entity_kind [not null]
  entity_id uuid [not null, note: 'trip, place, activity, … — per-message anchor']

  indexes {
    (message_id, entity_kind, entity_id) [unique]
    (entity_kind, entity_id)
  }
}

// Inline <place id=N>…</place> in message content or preference note → places.geom / bounds_geom
Table tagged_place_refs {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [ref: > conversation_messages.id]
  preference_id uuid [ref: > preferences.id]
  tag_index int [not null, note: 'N in <place id=N>; unique per host text blob']
  place_id uuid [not null, ref: > places.id]
  proximity_radius_m int [note: 'optional POI buffer for itinerary near alerts; NULL → use bounds or product default']

  indexes {
    (message_id, tag_index) [unique]
    (preference_id, tag_index) [unique]
    (place_id)
  }

  Note: 'CHECK: exactly one of message_id, preference_id set'
}

Table preference_evidence {
  preference_id uuid [not null, ref: > preferences.id]
  message_id uuid [not null, ref: > conversation_messages.id]
  source preference_evidence_source [not null, default: 'inferred']

  indexes {
    (preference_id, message_id) [unique]
    (message_id)
  }
}

// --- Secrets (optional server vault; v1 often device-only) ---

Table user_secret_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  slot_key text [not null, note: 'llm_api_key, oauth_gmail, …']
  label text
  ciphertext bytea [note: 'NULL if slot metadata only on device']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, slot_key) [unique]
  }
}
