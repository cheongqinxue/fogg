# Copy to repo root as .env and adjust (docker compose reads it automatically).
# Do not commit real secrets.

# --- Host ports (left side of docker compose `ports:`) — change if you have local conflicts ---
COMPOSE_PORT_REDIS=16379
COMPOSE_PORT_POSTGRES=15432
COMPOSE_PORT_OLLAMA=11434
COMPOSE_PORT_AGENT=18080
COMPOSE_PORT_BACKEND=18000
COMPOSE_PORT_PHOENIX=16006
COMPOSE_PORT_BROWSER_RESEARCH=18081

# Required for the private research service. Generate with: openssl rand -hex 32
BROWSER_AGENT_SERVICE_TOKEN=
BROWSER_AGENT_SERVICE_TIMEOUT_SECONDS=200
BROWSER_AGENT_TASK_TIMEOUT_SECONDS=180
BROWSER_WORKER_MAX_TASK_SECONDS=180
# Required proxy destination deny list: include deployment host addresses and all
# Docker/service public and private address ranges used by this deployment.
BROWSER_PROXY_DENY_HOSTS=

# Svelte dev server reads repo root .env (not only compose)
FRONTEND_WEB_PORT_DEBUG=8081
FRONTEND_WEB_PORT_RELEASE=8090
AGENT_API_BASE_URL=http://127.0.0.1:18080

# --- In-container listen ports (right side of mapping); must match Dockerfiles CMD ---
# AGENT_INTERNAL_PORT=8080
# BACKEND_INTERNAL_PORT=8000

# --- Postgres (PostGIS) ---
POSTGRES_USER=fogg
POSTGRES_PASSWORD=fogg
POSTGRES_DB=fogg

# Backend stub URL — use service hostname `postgres` and port 5432 inside the network
DATABASE_URL=postgresql://fogg:fogg@postgres:5432/fogg

# --- Redis (cache) — internal network; always redis:6379 unless you customize the redis image ---
COMPOSE_AGENT_REDIS_URL=redis://redis:6379/0

# --- Agent in Docker → OpenAI-compatible LLM (app still reads OPENAI_BASE_URL inside container) ---
# Default in docker-compose.yml is in-stack Ollama — omit or set explicitly:
# COMPOSE_AGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# Host Ollama instead: COMPOSE_AGENT_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Browser research uses UI-TARS-1.5 7B Q4_K_M with screenshot input.
# COMPOSE_BROWSER_AGENT_OLLAMA_URL=http://ollama:11434/api/chat
# Key sent to OpenAI-compatible server (Ollama ignores); avoids clashing with host OPENAI_API_KEY
AGENT_OPENAI_API_KEY=ollama
AGENT_MODEL=lfm3:1.7b
# Context and approximate input budget for the in-stack Ollama/browser research service.
OLLAMA_CONTEXT_LENGTH=32768
BROWSER_AGENT_MAX_INPUT_TOKENS=32000
# UI-TARS research task limits: 300 seconds, 80 graph steps, and 80 worker operations.
BROWSER_AGENT_TASK_TIMEOUT_SECONDS=300
BROWSER_WORKER_MAX_TASK_SECONDS=300
BROWSER_WORKER_ACTION_LIMIT=80
BROWSER_AGENT_SERVICE_TIMEOUT_SECONDS=320
CORS_ORIGINS=*

# LangGraph checkpoints in the agent *container* (in-network Postgres)
# COMPOSE_AGENT_DATABASE_URL=postgresql://fogg:fogg@postgres:5432/fogg
# Host agent (run-agent-debug.sh): AGENT_DATABASE_URL=postgresql://fogg:fogg@127.0.0.1:15432/fogg
