# Copy to .env and fill in locally (never commit .env).

# Google Maps Platform — required for live API calls
GOOGLE_MAPS_API_KEY=

# gmaps.settings — environment mode
FOGG_ENV=dev

# gmaps.quota.store — local usage counters
GMAPS_QUOTA_TRACKING=
GMAPS_QUOTA_STORE=redis
GMAPS_REDIS_URL=redis://127.0.0.1:6379/0
GMAPS_QUOTA_SQLITE_PATH=.data/gmaps-proxy/gmaps_usage.sqlite3
GMAPS_QUOTA_LOG=false
GMAPS_QUOTA_ENFORCE=
GMAPS_QUOTA_WARN_RATIO=0.8
GMAPS_QUOTA_WARN_REMAINING=500

# gmaps.response_cache — successful JSON response cache
GMAPS_CACHE_ENABLED=true
GMAPS_CACHE_TTL_SECONDS=3600

# gmaps.requests.base — retry loop on GoogleMapRequest.call()
# Max retries after the first HTTP attempt (total attempts = this + 1).
GMAPS_REQUESTS_BASE_MAX_RETRIES=5
GMAPS_REQUESTS_BASE_RETRY_WAIT_INITIAL_SECONDS=1
GMAPS_REQUESTS_BASE_RETRY_WAIT_MAX_SECONDS=60
