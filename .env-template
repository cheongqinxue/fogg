# Copy to .env and fill in locally (never commit .env).

# Google Maps Platform — required for live API calls
GOOGLE_MAPS_API_KEY=

# gmaps.settings — environment mode
FOGG_ENV=dev

# Phoenix traces are stored locally and may contain prompts and tool inputs/outputs.
FOGG_TRACING_ENABLED=true
FOGG_TRACING_PROJECT=fogg-dev
# COMPOSE_PORT_PHOENIX=16006

# Private browser research stack (required by docker compose profiles).
# Generate the service token with: openssl rand -hex 32
BROWSER_AGENT_SERVICE_TOKEN=
# Browser tool/service deadline is longer than the research task deadline for cleanup.
BROWSER_AGENT_SERVICE_TIMEOUT_SECONDS=320
BROWSER_AGENT_TASK_TIMEOUT_SECONDS=300
BROWSER_WORKER_MAX_TASK_SECONDS=300
BROWSER_WORKER_ACTION_LIMIT=80
# UI-TARS visual browser controller. Pull the configured Ollama model once before first use.
BROWSER_AGENT_MODEL=hf.co/Mungert/UI-TARS-1.5-7B-GGUF:Q4_K_M
BROWSER_AGENT_CONTEXT_LENGTH=32768
# Set the URL for the process hosting the browser-research service; Compose uses its internal Ollama URL.
BROWSER_AGENT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Include deployment host IPs and all proxy-reachable service address ranges.
BROWSER_PROXY_DENY_HOSTS=
# COMPOSE_PORT_BROWSER_RESEARCH=18081
# Optional browser identity overrides; leave blank for Playwright defaults.
BROWSER_USER_AGENT=
BROWSER_ACCEPT_LANGUAGE=
BROWSER_DNT=
BROWSER_SEC_CH_UA=
BROWSER_SEC_CH_UA_MOBILE=
BROWSER_SEC_CH_UA_PLATFORM=

# gmaps.quota.store — local usage counters
GMAPS_QUOTA_TRACKING=
GMAPS_QUOTA_STORE=redis
GMAPS_QUOTA_SQLITE_PATH=.data/gmaps-proxy/gmaps_usage.sqlite3
GMAPS_QUOTA_LOG=false
GMAPS_QUOTA_ENFORCE=
GMAPS_QUOTA_WARN_RATIO=0.8
GMAPS_QUOTA_WARN_REMAINING=500

# gmaps.response_cache — successful JSON response cache
GMAPS_CACHE_ENABLED=true
GMAPS_CACHE_TTL_SECONDS=3600

# gmaps.requests.base — retry loop on GoogleMapRequest.call()
# Max retries after the first HTTP attempt (total attempts = this + 1).
GMAPS_REQUESTS_BASE_MAX_RETRIES=5
GMAPS_REQUESTS_BASE_RETRY_WAIT_INITIAL_SECONDS=1
GMAPS_REQUESTS_BASE_RETRY_WAIT_MAX_SECONDS=60


# OpenAI-compatible server (Ollama: /v1 suffix; vLLM/SGLang: their /v1 base)
# Used by local `uv run uvicorn` / LangGraph — not by docker compose (see COMPOSE_AGENT_OPENAI_BASE_URL in deploy/compose.env.example).
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

# Model id as known to the server (Ollama: pull first — ollama pull lfm3:1.7b)
AGENT_MODEL=lfm3:1.7b
# Approximate input budget; leave room for tool schemas and model output in the model context.
AGENT_MAX_INPUT_TOKENS=20000
BROWSER_AGENT_MAX_INPUT_TOKENS=24000
# Ollama context window used by the local Compose service (model server may require restart).
OLLAMA_CONTEXT_LENGTH=32768

# Allow POST /v1/dev/reset (nuclear layout + checkpoint clear). Never enable in production.
# AGENT_DEV_RESET_ENABLED=true

# LangGraph thread checkpoints (Postgres). Host uvicorn defaults to 127.0.0.1:COMPOSE_PORT_POSTGRES if unset.
# Override when not using compose Postgres on 15432:
# AGENT_DATABASE_URL=postgresql://fogg:fogg@127.0.0.1:15432/fogg

# --- Ports (local dev; docker compose uses deploy/compose.env.example) ---
# Svelte dev server (frontend/svelte)
FRONTEND_WEB_PORT_DEBUG=8081
FRONTEND_WEB_PORT_RELEASE=8090
# Docker Compose host publish (optional; copy deploy/compose.env.example → .env)
# COMPOSE_PORT_OLLAMA=11434
# Agent API base URL for the browser frontend (match uvicorn / COMPOSE_PORT_AGENT)
AGENT_API_BASE_URL=http://127.0.0.1:18080
